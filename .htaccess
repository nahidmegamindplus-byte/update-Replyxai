# ==============================================================================
# ReplyX AI — Production Hostinger LiteSpeed / Apache & Passenger Configuration
# ==============================================================================

# 1. Phusion Passenger configuration for Hostinger Cloud / Shared cPanel Node.js Selector
<IfModule mod_passenger.c>
  PassengerNodejs /usr/bin/node
  PassengerAppType node
  PassengerStartupFile server.js
  PassengerRestartDir tmp
  PassengerAppRoot .
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 2. Force HTTPS safely (avoid loop behind reverse proxy / Cloudflare / Hostinger CDN)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Block direct web access to sensitive environment & SQLite database files
  RewriteRule ^\.env - [F,L,NC]
  RewriteRule ^prisma/.*\.db - [F,L,NC]
  RewriteRule ^prisma/.*\.db-journal - [F,L,NC]
  RewriteRule ^prisma/.*\.db-wal - [F,L,NC]
  RewriteRule ^prisma/.*\.db-shm - [F,L,NC]

  # 4. Direct access to existing physical static files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Direct access for Next.js static CSS & JS in .next/static or _next/static
  RewriteCond %{DOCUMENT_ROOT}/.next/static/$1 -f
  RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/_next/static/$1 -f
  RewriteRule ^_next/static/(.*)$ _next/static/$1 [L]

  # 6. Direct access for global.css
  RewriteCond %{DOCUMENT_ROOT}/public/global.css -f
  RewriteRule ^global\.css$ public/global.css [L]

  # 7. Direct access for public assets
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # 8. Reverse Proxy Fallback for Standalone Node.js / PM2 on Port 3000 (when mod_passenger is off)
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>
</IfModule>

# Ensure exact MIME types so browsers never reject CSS or JavaScript
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# Granular Caching & CORS Headers:
# 1. HTML pages: Always fresh (prevents outdated chunk hashes & ChunkLoadError after deploy)
# 2. Static assets: 1-Year immutable caching with CORS & nosniff
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|json|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

# Browser Gzip / Deflate compression for ultra-fast page loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
