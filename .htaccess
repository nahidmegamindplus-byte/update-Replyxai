# ==============================================================================
# ReplyX AI — Hostinger LiteSpeed / Apache & Passenger Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent direct web access to sensitive environment, sqlite & prisma files
  RewriteRule ^\.env.*$ - [F,L]
  RewriteRule ^prisma/.*\.db$ - [F,L]
  RewriteRule ^prisma/.*\.db-journal$ - [F,L]
  RewriteRule ^prisma/.*\.db-wal$ - [F,L]
  RewriteRule ^prisma/.*\.db-shm$ - [F,L]

  # 3. WebSocket and Proxy headers forwarding
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule /(.*) ws://127.0.0.1:3000/$1 [P,L]
</IfModule>

# Phusion Passenger configuration (when managed via Hostinger Node.js Application Manager)
<IfModule mod_passenger.c>
  PassengerNodejs /usr/bin/node
  PassengerAppType node
  PassengerStartupFile server.js
  PassengerRestartDir tmp
</IfModule>

# Gzip compression for static performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
