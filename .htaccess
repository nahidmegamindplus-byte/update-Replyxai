# ==============================================================================
# ReplyX AI — Safe Hostinger LiteSpeed / Apache Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Block direct web access to sensitive environment & SQLite database files
  RewriteRule ^\.env - [F,L,NC]
  RewriteRule ^prisma/.*\.db - [F,L,NC]
  RewriteRule ^prisma/.*\.db-journal - [F,L,NC]
  RewriteRule ^prisma/.*\.db-wal - [F,L,NC]
  RewriteRule ^prisma/.*\.db-shm - [F,L,NC]

  # 3. Direct access to existing physical static files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Direct access for Next.js static CSS & JS in .next/static or _next/static
  RewriteCond %{DOCUMENT_ROOT}/.next/static/$1 -f
  RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/_next/static/$1 -f
  RewriteRule ^_next/static/(.*)$ _next/static/$1 [L]

  # Direct access for global.css
  RewriteCond %{DOCUMENT_ROOT}/public/global.css -f
  RewriteRule ^global\.css$ public/global.css [L]

  # Direct access for public assets
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Ensure exact MIME types so browsers never reject CSS or JavaScript
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# CORS & Security headers so no browser blocks stylesheets or scripts
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|json|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf|eot)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

# Browser Gzip / Deflate compression for ultra-fast page loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

